{
  "name": "notaflow",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --parallel typecheck && pnpm typecheck:root",
    "test": "vitest run",
    "format": "prettier --write .",
    "prepare": "git config core.hooksPath .githooks || true",
    "typecheck:root": "tsc -p tsconfig.json",
    "spike:sefin": "tsx --env-file=.env.local spikes/2026-10-sefin/run.ts",
    "spike:sefin:cancel": "tsx --env-file=.env.local spikes/2026-10-sefin/cancel.ts",
    "fake:nacional": "tsx packages/fake-nacional/src/cli.ts",
    "spike:adn-read": "tsx --env-file=.env.local spikes/2026-10-adn-read/run.ts",
    "spike:new-invoice": "tsx --env-file=.env.local spikes/2026-10-new-invoice/run.ts",
    "spike:template-check": "tsx spikes/2026-10-template-check/run.ts",
    "malphas:check": "node scripts/malphas-check.mjs",
    "seo:faq": "node scripts/landing-faq-jsonld.mjs",
    "notice:legal": "tsx --env-file=apps/server/.env.local apps/server/src/policyNotice.ts",
    "dev:server": "tsx --env-file=apps/server/.env.local apps/server/src/main.ts",
    "seed:admin": "tsx --env-file=apps/server/.env.local apps/server/src/seed.ts",
    "dev:web": "pnpm --filter @notaflow/web exec vite",
    "build:web": "pnpm --filter @notaflow/web build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@notaflow/provider-nacional": "workspace:*",
    "@notaflow/signer-node": "workspace:*",
    "@types/node": "^26.6.5",
    "eslint": "^9.17.0",
    "playwright": "1.63.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
