%% C4 level 1: system context. Render with diagrams/render.html (see README.md).
flowchart TB
  owner["<b>Company user</b><br/><i>[Person]</i><br/>Owner or member of a Simples Nacional company. Issues, copies, and cancels invoices."]
  admin["<b>Platform admin</b><br/><i>[Person]</i><br/>Vapulab staff. Manages accounts, users, and dead-letter e-mails."]

  notaflow["<b>NotaFlow</b><br/><i>[Software system]</i><br/>Issues, copies, cancels, and imports NFS-e for many companies, with the Simples rate by the law."]

  nacional["<b>National NFS-e system</b><br/><i>[External system]</i><br/>Sefin Nacional receives DPS and events; the ADN returns each emitter's documents. mTLS with the company's A1 certificate."]
  resend["<b>Resend</b><br/><i>[External system]</i><br/>Sends login codes, invites, and welcome e-mails."]
  google["<b>Google</b><br/><i>[External system]</i><br/>Optional OAuth login."]
  cloudflare["<b>Cloudflare</b><br/><i>[External system]</i><br/>DNS, tunnel to the VPS, and Turnstile against bots."]
  r2["<b>Cloudflare R2</b><br/><i>[External system]</i><br/>Private buckets: the encrypted off-site backups, and the bug report screenshots until 30 days after the fix."]
  lookups["<b>Public lookups</b><br/><i>[External systems]</i><br/>BrasilAPI and CNPJá (CNPJ), ViaCEP (CEP), Banco Central (PTAX), Have I Been Pwned (k-anonymity)."]
  posthog["<b>PostHog</b><br/><i>[External system]</i><br/>Product analytics, no cookies, internal user id only."]
  sentry["<b>Sentry</b><br/><i>[External system]</i><br/>Error reports from the server and the browser, scrubbed of personal data."]
  github["<b>GitHub</b><br/><i>[External system]</i><br/>Public repository Vapulab/notaflow: one masked issue of type Bug per bug report. Its webhook tells when an issue closes."]
  discord["<b>Discord</b><br/><i>[External system]</i><br/>Private channel for new and resolved bugs."]
  notion["<b>Notion</b><br/><i>[External system]</i><br/>Bugs database: one card per bug report, with the full text."]

  owner -- "Uses, in the browser [HTTPS]" --> notaflow
  admin -- "Administers [HTTPS]" --> notaflow
  notaflow -- "Issues, cancels, and reads invoices [HTTPS, mTLS]" --> nacional
  notaflow -- "Sends e-mail [HTTPS API]" --> resend
  notaflow -- "OAuth login [HTTPS]" --> google
  cloudflare -- "Carries every request [Tunnel]" --> notaflow
  notaflow -- "Encrypted daily backup [HTTPS]" --> r2
  notaflow -- "Bug screenshots: put, get, delete [HTTPS, S3 API]" --> r2
  notaflow -- "Looks up CNPJ, CEP, PTAX, breached passwords [HTTPS]" --> lookups
  owner -. "Page views and product events [HTTPS]" .-> posthog
  notaflow -. "Error reports [HTTPS]" .-> sentry
  resend -. "Delivers e-mail" .-> owner
  notaflow -- "Opens bug issues [HTTPS API]" --> github
  github -- "Issue closed or reopened [HTTPS webhook]" --> notaflow
  notaflow -- "Bug messages [HTTPS webhook]" --> discord
  notaflow -- "Bug cards and status [HTTPS API]" --> notion

  classDef person fill:#08427b,stroke:#052e56,color:#fff
  classDef system fill:#1168bd,stroke:#0b4884,color:#fff
  classDef external fill:#8a8a8a,stroke:#6b6b6b,color:#fff
  class owner,admin person
  class notaflow system
  class nacional,resend,google,cloudflare,r2,lookups,posthog,sentry,github,discord,notion external
