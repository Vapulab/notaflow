# /opt/notaflow/.env on the VPS, mode 600. Never commit the real file.
# IMAGE is written by the deploy workflow after each successful pull.
IMAGE=
NODE_ENV=production
APP_ORIGIN=https://notaflow.vapulab.com
# 32 random bytes in base64, generated on the VPS: openssl rand -base64 32
# Keep a copy in the password manager, never next to the backups.
NFSE_MASTER_KEY=
AUTH_MODE=session
# At least 32 characters, generated on the VPS: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Resend API key with sending access for notaflow.vapulab.com.
RESEND_API_KEY=
# Google OAuth client (Google Cloud console, project NotaFlow); both or neither.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Turnstile widget of notaflow.vapulab.com (Cloudflare dashboard); required in production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# false until stage 3c ships onboarding: existing users log in, new e-mails are refused.
SIGNUP_OPEN=false
