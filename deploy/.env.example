# /opt/notaflow/.env on the VPS, mode 600. Never commit the real file.
# IMAGE is written by the deploy workflow after each successful pull.
IMAGE=
NODE_ENV=production
APP_ORIGIN=https://notaflow.vapulab.com
# 32 random bytes in base64, generated on the VPS: openssl rand -base64 32
# Keep a copy in the password manager, never next to the backups.
NFSE_MASTER_KEY=
AUTH_MODE=session
# At least 32 characters, generated on the VPS: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Resend API key with sending access for notaflow.vapulab.com.
RESEND_API_KEY=
# Google OAuth client (Google Cloud console, project NotaFlow); both or neither.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Turnstile widget of notaflow.vapulab.com (Cloudflare dashboard); required in production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# false until stage 3c ships onboarding: existing users log in, new e-mails are refused.
SIGNUP_OPEN=false
# Bug reports; each channel is off while its variables are empty.
# Fine-grained token of the bot account, Issues read and write on Vapulab/notaflow only.
GITHUB_BUG_TOKEN=
GITHUB_BUG_REPO=Vapulab/notaflow
# The secret of the issues webhook of Vapulab/notaflow, generated on the VPS: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
# The webhook URL of the private Discord bugs channel.
DISCORD_BUG_WEBHOOK_URL=
# The Notion integration "NotaFlow bugs", shared with the bugs database.
NOTION_TOKEN=
NOTION_BUGS_DATABASE_ID=
# The private R2 bucket of bug report screenshots (docs/TUTORIALS/DEPLOY_ON_VM.md, "Bug report screenshots").
# All four or none. The token has Object Read and Write on this bucket only.
R2_ACCOUNT_ID=
R2_BUG_REPORTS_ACCESS_KEY_ID=
R2_BUG_REPORTS_SECRET_ACCESS_KEY=
R2_BUG_REPORTS_BUCKET=notaflow-bug-screenshots
