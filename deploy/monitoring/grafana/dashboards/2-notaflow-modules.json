        "y": 26,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(certificate_expiry_timestamp_seconds - time())",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 2592000
              },
              {
                "color": "green",
                "value": 5184000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
