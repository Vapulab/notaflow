# Copy to apps/server/.env.local for local development. Never commit the real file.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=apps/server/data/notaflow.db
# The Vite dev server origin; production uses the public URL.
APP_ORIGIN=http://localhost:5173
# 32 random bytes in base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NFSE_MASTER_KEY=
# dev skips the login and acts as DEV_USER_EMAIL; session uses the own login (Better Auth).
AUTH_MODE=dev
DEV_USER_EMAIL=
# At least 32 characters, required with AUTH_MODE=session: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Without a key, development prints e-mails to the console; production requires it.
RESEND_API_KEY=
# The Resend webhook signing secret (whsec_...) for bounces and complaints at /webhooks/resend; empty answers 404.
RESEND_WEBHOOK_SECRET=
MAIL_FROM=NotaFlow <nao-responda@notaflow.vapulab.com>
# Optional sender of the e-mail to a customer with an invoice link; falls back to MAIL_FROM.
MAIL_FROM_INVOICE=
# Both or neither; neither hides "Entrar com Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Both or neither outside production; required in production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Whether a new e-mail can create a user (true or false), and the new users per IP per day.
SIGNUP_OPEN=false
SIGNUP_LIMIT_PER_IP_DAY=5
# Local development against pnpm fake:nacional; refused in production.
NACIONAL_FAKE_URL=http://127.0.0.1:4010
# Product analytics; the project key is public. Without it, nothing is sent.
POSTHOG_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
# Production behind the Cloudflare tunnel only: trust cf-connecting-ip as the client IP.
TRUST_CLOUDFLARE_IP=false
# Production: the tunnel container's name. Then only that peer may send cf-connecting-ip.
TRUSTED_PROXY_HOST=
# The Prometheus /metrics listener, inside the container only (no host port); 0 turns it off.
METRICS_PORT=9464
# Production: the Prometheus container's name. Then /metrics answers only that peer.
METRICS_ALLOW_HOST=
# Error reports to Sentry, scrubbed of personal data; without a DSN nothing is sent. The browser DSN is public.
SENTRY_DSN_SERVER=
SENTRY_DSN_WEB=
# The first day (YYYY-MM-DD) the lifecycle reminders may go out; empty keeps them off.
LIFECYCLE_START_AT=
# Bug reports: each channel is off while its variables are empty.
# A fine-grained token with Issues read and write on GITHUB_BUG_REPO (owner/name); both or neither.
GITHUB_BUG_TOKEN=
GITHUB_BUG_REPO=
# The secret of the GitHub issues webhook to /webhooks/github; empty answers 404.
GITHUB_WEBHOOK_SECRET=
# The Discord channel webhook URL (https) for new and resolved bugs.
DISCORD_BUG_WEBHOOK_URL=
# A Notion integration token and the id of the bugs database it can edit; both or neither.
NOTION_TOKEN=
NOTION_BUGS_DATABASE_ID=
# The private R2 bucket of bug report screenshots; all four or none. None hides the image picker.
# R2_ACCOUNT_ID is the 32-character Cloudflare account id; the token is scoped to the bucket only.
R2_ACCOUNT_ID=
R2_BUG_REPORTS_ACCESS_KEY_ID=
R2_BUG_REPORTS_SECRET_ACCESS_KEY=
R2_BUG_REPORTS_BUCKET=
